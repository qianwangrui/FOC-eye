# clangd config for the cross-compiled (arm-none-eabi-gcc) project.
# Uses compile_commands.json (generated by `bear -- make`) plus a few
# tweaks so the host clang can parse Cortex-M4 sources cleanly.
CompileFlags:
  CompilationDatabase: .
  Add:
    - --target=arm-none-eabi
    - -IInc
    - -IAPP
    - -IDrivers/STM32G4xx_HAL_Driver/Inc
    - -IDrivers/STM32G4xx_HAL_Driver/Inc/Legacy
    - -IDrivers/CMSIS/Device/ST/STM32G4xx/Include
    - -IDrivers/CMSIS/Include
    - -DSTM32G431xx
    - -DUSE_HAL_DRIVER
    # newlib (libc) headers shipped with arm-none-eabi-gcc on Debian/Ubuntu.
    - -isystem/usr/include/newlib
    # arm-none-eabi-gcc built-in headers (stddef.h, stdint.h, ...).
    - -isystem/usr/lib/gcc/arm-none-eabi/10.3.1/include
  # Strip flags clang does not understand from the GCC build.
  Remove:
    - -mcpu=*
    - -mfpu=*
    - -mfloat-abi=*
    - -specs=*
    - --specs=*

Diagnostics:
  Suppress:
    - drv_unknown_argument
  # IncludeCleaner often false-positives on HAL umbrella headers
  # (stm32g4xx_hal.h pulls in types via macros it cannot trace).
  UnusedIncludes: None
  MissingIncludes: None
